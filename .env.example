# Configuración del Servidor
PORT=8080
ENV=development

# Configuración de Base de Datos (Neo4j Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Claves de APIs Externas
# Regístrate en https://nvd.nist.gov/developers/request-an-api-key para obtener tu API Key y aumentar el límite de peticiones.
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_TIMEOUT=90
NVD_CACHE_TTL_HOURS=6

# Configuración de Ollama (LLM local para mapeo de CVE → TTP)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
